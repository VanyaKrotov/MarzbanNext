{
  "v2ray-json": {
    "$defs": {
      "InjectHosts": {
        "additionalProperties": false,
        "properties": {
          "selector": {
            "anyOf": [
              {
                "$ref": "#/$defs/Selector"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Restrict authorized sources by host ID, group or rendered name."
          },
          "selectFrom": {
            "default": "HIDDEN",
            "description": "Inject hidden, visible, or all authorized sources. The recipient itself is excluded.",
            "enum": ["ALL", "HIDDEN", "VISIBLE"],
            "title": "Selectfrom",
            "type": "string"
          },
          "tagPrefix": {
            "description": "Stable unique prefix for generated outbound tags and balancer selectors.",
            "maxLength": 256,
            "minLength": 1,
            "title": "Tagprefix",
            "type": "string"
          }
        },
        "required": ["tagPrefix"],
        "title": "InjectHosts",
        "type": "object"
      },
      "Selector": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ids"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "values": {
                  "items": {
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "prefix": false,
                "pattern": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "groups"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "values": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "prefix": false,
                "pattern": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "sameGroupsAsRecipient"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "values": {
                  "maxItems": 0
                },
                "prefix": false,
                "pattern": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remarks"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "values": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1
                },
                "prefix": false,
                "pattern": false
              },
              "required": ["values"]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remarkPrefix"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "values": false,
                "pattern": false,
                "prefix": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["prefix"]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "remarkRegex"
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "values": false,
                "prefix": false,
                "pattern": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["pattern"]
            }
          }
        ],
        "defaultSnippets": [
          {
            "body": {
              "type": "ids",
              "values": [11, 12]
            },
            "label": "Host IDs"
          },
          {
            "body": {
              "type": "remarks",
              "values": ["Netherlands", "Finland"]
            },
            "label": "Exact host names"
          },
          {
            "body": {
              "prefix": "EU-",
              "type": "remarkPrefix"
            },
            "label": "Host name prefix"
          },
          {
            "body": {
              "pattern": "^(NL|FI)-",
              "type": "remarkRegex"
            },
            "label": "Host name regex"
          }
        ],
        "description": "Select authorized hosts by ID, group or rendered name. Name matching is case-sensitive.",
        "properties": {
          "type": {
            "description": "Select by host IDs, group IDs, exact names, a name prefix or a regular expression.",
            "enum": [
              "ids",
              "groups",
              "sameGroupsAsRecipient",
              "remarks",
              "remarkPrefix",
              "remarkRegex"
            ],
            "title": "Type",
            "type": "string"
          },
          "values": {
            "description": "Host IDs, group IDs or exact rendered names, according to type.",
            "examples": [[11, 12], ["eu"], ["Netherlands", "Finland"]],
            "items": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": "Values",
            "type": "array"
          },
          "prefix": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Literal prefix of the rendered host name, including spaces. Only for remarkPrefix.",
            "examples": ["EU-"],
            "title": "Prefix"
          },
          "pattern": {
            "anyOf": [
              {
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Regular expression searched anywhere in the rendered host name. Use ^ for a prefix or ^...$ for an exact match, without /.../ delimiters. Only for remarkRegex; checked by the server.",
            "examples": ["^(NL|FI)-", "^Netherlands$"],
            "title": "Pattern"
          }
        },
        "required": ["type"],
        "title": "Selector",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "addVirtualHostAsOutbound": {
        "default": true,
        "description": "Include the recipient's own connection as an outbound.",
        "title": "Addvirtualhostasoutbound",
        "type": "boolean"
      },
      "injectHosts": {
        "description": "Add connections from selected hosts to this Xray configuration.",
        "items": {
          "$ref": "#/$defs/InjectHosts"
        },
        "title": "Injecthosts",
        "type": "array"
      }
    },
    "title": "XrayDirectives",
    "type": "object"
  },
